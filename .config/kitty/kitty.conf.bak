# ==============================
# Theming
# ==============================
include dark-theme.conf
single_window_margin_width 0 4 2 4

# ==============================
# Transparency / Blur
# ==============================
background_opacity 0.80
background_blur 0

# ==============================
# Cursor
# ==============================
cursor_trail 3
cursor_trail_decay 0.1 0.3
cursor_blink_interval 0.65
cursor_shape block
cursor_beam_thickness 2
cursor_underline_thickness 1

# ==============================
# Tab bar
# ==============================
tab_activity_symbol "◉"
active_tab_font_style normal
inactive_tab_font_style normal
tab_bar_style separator
tab_separator "◆︎"

# ==============================
# Font
# ==============================
font_size 14
font_family      "JetBrains Mono"
bold_font        Ubuntu Mono Bold
italic_font      Ubuntu Mono Italic
bold_italic_font auto

# ==============================
# Scrolling
# ==============================
scrollback_lines 1000
scrollbar never

# ==============================
# Shell
# ==============================
shell /run/current-system/sw/bin/fish

shell_integration enabled
shell_integration no-cursor

copy_on_select yes
mouse_map right press ungrabbed paste_from_selection

remember_window_size no
initial_window_width 80c
initial_window_height 24c

close_on_child_death yes

# ==============================
# Mapping
# ==============================
map ctrl+backspace ctrl+w

map ctrl+shift+h previous_tab
map ctrl+shift+l next_tab
map alt+1 goto_tab 1
map alt+2 goto_tab 2
map alt+3 goto_tab 3
map alt+4 goto_tab 4
map alt+5 goto_tab 5
map alt+6 goto_tab 6
map alt+7 goto_tab 7
map alt+8 goto_tab 8
map alt+9 goto_tab 9

map shift+up         scroll_line_up
map shift+page_up    scroll_page_up
map shift+down       scroll_line_down
map shift+page_down  scroll_page_down

# ==============================
# macOS settings (REMOVE IF YOU USE LINUX)
# ==============================
macos_show_window_title_in none
macos_menubar_title_max_length 0
macos_titlebar_color #1e1e2e
macos_quit_when_last_window_closed yes
