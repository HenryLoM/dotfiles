{
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "color": {"1": "white"},
        "padding": { "top": 0 }
    },
    "display": {
        "separator": " ",
        "size": {
            "binaryPrefix": "jedec",
            "maxPrefix": "GB",
            "ndigits": 0
        }
    },
    "modules": [
        { "type": "break" },
        { "type": "break" },
        {
            "type": "os",
            "key": "os       :",
            "keyColor": "white",
            "outputColor": "light_white",
            "format": "{name} {codename}"
        },
        {
            "type": "cpu",
            "key": "cpu      :",
            "keyColor": "white",
            "outputColor": "light_white",
            "format": "{name}"
        },
        {
            "type": "shell",
            "key": "shell    :",
            "keyColor": "white",
            "outputColor": "light_white",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "terminal :",
            "keyColor": "white",
            "outputColor": "light_white",
            "format": "{pretty-name}"
        }
    ]
}
