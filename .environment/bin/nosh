#!/usr/bin/env bash

# ========== ========== ==========
# Help
# ========== ========== ==========

case "$1" in
    -h|--help|help|h)
        echo "nosh - lightweight turn-based note taking script"
        echo
        echo "Usage:"
        echo "    nosh <file>"
        echo
        echo "Args:"
        echo "    <file>              path of the editing file"
        echo
        echo "Commands:"
        echo "    a                   append line"
        echo "    i                   insert line"
        echo "    e                   edit line"
        echo "    d                   delete line"
        echo "    s                   save file"
        echo "    q                   quit"
        echo
        exit 0
        ;;
esac

# ========== ========== ==========
# Logiv itself
# ========== ========== ==========

FILE="$1"

# Prevent running without filename
if [[ -z "$FILE" ]]; then
    echo "Please specify a file name."
    echo "Usage: nosh <filename>"
    exit 1
fi

declare -a buffer

# Load file if it exists
if [[ -f "$FILE" ]]; then
    mapfile -t buffer < "$FILE"
fi

show_buffer() {
    clear
    echo "=== Nosh - Note taking Bash script ==="
    echo "File: $FILE"
    echo

    for i in "${!buffer[@]}"; do
        printf "%3d | %s\n" "$((i + 1))" "${buffer[$i]}"
    done

    echo
    echo "[a] append  [i] insert  [e] edit  [d] delete"
    echo "[s] save    [q] quit"
}

append_line() {
    read -rp "Text: " text
    buffer+=("$text")
}

insert_line() {
    read -rp "Insert before line: " line
    read -rp "Text: " text

    ((line--))

    buffer=(
        "${buffer[@]:0:$line}"
        "$text"
        "${buffer[@]:$line}"
    )
}

edit_line() {
    read -rp "Line number: " line
    ((line--))

    if [[ -n "${buffer[$line]+x}" ]]; then
        echo "Current: ${buffer[$line]}"
        read -rp "New text: " text
        buffer[$line]="$text"
    else
        echo "Invalid line."
        read -n1 -r -p "Press any key..."
    fi
}

delete_line() {
    read -rp "Line number: " line
    ((line--))

    unset 'buffer[line]'
    buffer=("${buffer[@]}")
}

save_file() {
    printf "%s\n" "${buffer[@]}" > "$FILE"
    echo "Saved."
    sleep 1
}

# Main loop
while true; do
    show_buffer

    read -rp "Choice: " choice

    case "$choice" in
        a) append_line ;;
        i) insert_line ;;
        e) edit_line ;;
        d) delete_line ;;
        s) save_file ;;
        q) exit 0 ;;
    esac
done
