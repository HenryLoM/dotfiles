#!/usr/bin/env bash

# ==============================
# Help
# ==============================
case "${1:-}" in --help|-help|help|--h|-h|h)
    echo "muz (v3.0) - nearly suckless local music player"
    echo
    echo "Usage: muz <music-directory>"
    echo
    echo "Controls:"
    echo "    ↑ / k               move up"
    echo "    ↓ / j               move down"
    echo "    → / l / Enter       enter directory / play file"
    echo "    ← / h               go back to parent directory"
    echo "    c                   enable chain mode"
    echo "    s                   enable shuffle mode"
    echo "    r                   enable repeat mode"
    echo "    a                   disable artwork"
    echo "    q / Esc             quit"
    echo
    echo "Dependencies: mpv ffmpeg ffprobe tput"
    echo "Cache: ~/.cache/muz/"
    exit 0
    ;;
esac

# ==============================
# Dependencies
# ==============================
dependencies=(mpv ffmpeg ffprobe tput)
for cmd in "${dependencies[@]}"; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "muz: missing dependency: $cmd" >&2; missing=1; }
done
(( ${missing:-0} )) && exit 1

# ==============================
# Cache
# ==============================
CACHE_DIR="$HOME/.cache/muz"
CACHED_PATH="$CACHE_DIR/path"
mkdir -p "$CACHE_DIR"

ROOT="${1:-$(cat "$CACHED_PATH" 2>/dev/null)}"
[[ -n "$ROOT" ]] || { echo "muz: usage: muz <music-directory>" >&2; exit 1; }
[[ -d "$ROOT" ]] || { echo "muz: $ROOT is not a directory"     >&2; exit 1; }
echo "$ROOT" > "$CACHED_PATH"

# ==============================
# State
# ==============================
declare -a ENTRIES=() PATH_STACK=()
CURRENT_DIR="$ROOT"
DIR_COUNT=0
CURSOR=0
MODE=""
ARTWORK_ENABLED=1
META_ARTIST="" META_ALBUM="" META_YEAR="" META_TITLE="" META_TRACK=""

# ==============================
# Terminal sequences
# ==============================
enter_alternative_screen() { printf "\e[?1049h"; }
exit_alternative_screen()  { printf "\e[?1049l"; }
hide_cursor() { printf "\e[?25l"; }
show_cursor() { printf "\e[?25h"; }
clean_artwork() { printf "\033_Ga=d,d=A\033\\"; }

# ==============================
# Files and metadata
# ==============================
has_music() { find "$1" -type f \( -iname "*.mp3" -o -iname "*.ogg" -o -iname "*.opus" -o -iname "*.aac" -o -iname "*.flac" -o -iname "*.wav" \) -print -quit 2>/dev/null | grep -q .; }

load_entries() {
    local -a dirs=() files=()
    while IFS= read -r d; do dirs+=("$d");  done < <(find "$1" -mindepth 1 -maxdepth 1 -type d -print | LC_ALL=C.UTF-8 sort -f | while IFS= read -r d; do has_music "$d" && printf "%s\n" "$d"; done)
    while IFS= read -r f; do files+=("$f"); done < <(find "$1" -mindepth 1 -maxdepth 1 -type f \( -iname "*.mp3" -o -iname "*.ogg" -o -iname "*.opus" -o -iname "*.aac" -o -iname "*.flac" -o -iname "*.wav" \) -print | LC_ALL=C.UTF-8 sort -f)
    ENTRIES=("${dirs[@]}" "${files[@]}")
    DIR_COUNT=${#dirs[@]}
}

update_metadata() {
    local file="${ENTRIES[CURSOR]}"
    META_ARTIST="" META_ALBUM="" META_YEAR="" META_TRACK=""
    if (( CURSOR < DIR_COUNT || CURSOR >= ${#ENTRIES[@]} )); then
        META_TITLE="${file##*/}"
        return
    fi
    IFS=$'\034' read -r META_ARTIST META_ALBUM META_YEAR META_TITLE META_TRACK < <(ffprobe -v quiet -show_entries format_tags:stream_tags -of default=noprint_wrappers=1 "$file" 2>/dev/null | awk -F= '
        tolower($1)=="tag:artist" { artist=substr($0,index($0,"=")+1) }
        tolower($1)=="tag:album"  {  album=substr($0,index($0,"=")+1) }
        tolower($1)=="tag:date"   {   year=substr($0,index($0,"=")+1) }
        tolower($1)=="tag:title"  {  title=substr($0,index($0,"=")+1) }
        tolower($1)=="tag:track"  {  track=substr($0,index($0,"=")+1) }
        END { printf "%s\034%s\034%s\034%s\034%s\n", artist,album,year,title,track }')
    META_ARTIST="${META_ARTIST:-Unknown Artist}"
    META_ALBUM="${META_ALBUM:-Unknown Album}"
    META_YEAR="${META_YEAR:-Unknown Year}"
    META_TITLE="${META_TITLE:-${file##*/}}"
    META_TRACK="${META_TRACK:--/-}"
}

read_key() {
    local key seq
    IFS= read -rsn1 key
    if [[ $key == $'\e' ]]; then IFS= read -rsn2 -t .1 seq; key+="$seq"; fi
    case "$key" in
        $'\e[A'|k)    echo up     ;;
        $'\e[B'|j)    echo down   ;;
        $'\e[D'|h)    echo back   ;;
        $'\e[C'|l|"") echo enter  ;;
        a|c|s|r)      echo "$key" ;;
        $'\e'|q)      echo quit   ;;
    esac
}

# ==============================
# Artwork
# ==============================
display_artwork() {
    local cols lines width height col
    cols=$(tput cols); lines=$(tput lines)
    (( cols > 2 && lines > 2 )) || return
    width=$((cols / 2)); height=$(((lines - 2) * 2)); col=$((cols - width + 1))
    # Attempt #1 - Kitty Graphics Protocol
    if [[ "${TERM:-}" =~ ^(xterm-)?(kitty|ghostty)$ ]] &&
        ffmpeg -y -i "$1" -an -vcodec copy "$CACHE_DIR/cover.jpg" 2>/dev/null &&
        kitty +kitten icat --silent --stdin no --place="${width}x$((lines - 2))@$((col - 1))x0" "$CACHE_DIR/cover.jpg" 2>/dev/null; then
        rm -f "$CACHE_DIR/cover.jpg"; return
    fi
    # Attempt #2 - Chafa
    if [[ "${TERM_PROGRAM:-}" =~ (rio|ghostty)$ ]] && command -v chafa >/dev/null 2>&1 &&
        ffmpeg -y -i "$1" -an -vcodec copy "$CACHE_DIR/cover.jpg" 2>/dev/null &&
        { printf "\033[%d;%dH" 1 "$col"; chafa --format kitty -s "${width}x$((lines - 1))" "$CACHE_DIR/cover.jpg" 2>/dev/null; }; then
        rm -f "$CACHE_DIR/cover.jpg"; return
    fi
    # Attempt #3 - ASCII with no extra dependencies
    ffmpeg -v error -i "$1" -map 0:v:0 -frames:v 1 \
        -vf "scale=${width}:${height}:force_original_aspect_ratio=decrease,pad=${width}:${height}:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1" \
        -f rawvideo -pix_fmt rgb24 - 2>/dev/null | od -An -v -t u1 | awk -v w="$width" -v col="$col" '
            function row(n, x) { printf "\033[%d;%dH", n, col; for (x=1; x<=w; x++) printf "\033[38;2;%d;%d;%dm\033[48;2;%d;%d;%dm▀", tr[x],tg[x],tb[x],br[x],bg[x],bb[x]; printf "\033[0m" }
            { for (i=1; i<=NF; i++) { c[++n]=$i; if (n==3) { p++; x=(p-1)%w+1; y=int((p-1)/w)+1; if (y%2) { tr[x]=c[1]; tg[x]=c[2]; tb[x]=c[3] } else { br[x]=c[1]; bg[x]=c[2]; bb[x]=c[3]; if (x==w) row(1+int((y-1)/2)) }; n=0 } } }
        '
}

# ==============================
# Playback
# ==============================
play_from() {
    local idx="$1"
    while (( idx < ${#ENTRIES[@]} )); do
        if (( idx >= DIR_COUNT )); then
            # Display artwork (if enabled) -> Update metadata -> Print metadata -> Play file -> Handle playback modes (if chosen)
            (( ARTWORK_ENABLED  )) && display_artwork "${ENTRIES[idx]}"
            CURSOR=$idx; update_metadata
            printf "\e[3;1H\e[1;97m %s\e[0m\n\e[4;1H\e[37m %s\e[0m\n\e[5;1H\e[37m %s\e[0m\n\e[6;1H\e[2;37m %s | %s\e[0m\n" "$META_TITLE" "$META_ALBUM" "$META_ARTIST" "$META_TRACK" "$META_YEAR"
            mpv --no-video --no-pause --no-keep-open --msg-level=ffmpeg=no,ao=no,vo=no,cplayer=no,osd/libass=no --term-status-msg=" \${time-pos} | \${duration}" --display-tags=no "${ENTRIES[idx]}" || break
            [[ $MODE == repeat  ]] && {                                   clear; continue; }
            [[ $MODE == shuffle ]] && { idx=$((RANDOM % ${#ENTRIES[@]})); clear; continue; }
            [[ $MODE == chain   ]] || {                                   clear; break;    }
            clear
        fi
        ((idx++))
    done
    clean_artwork
}

# ==============================
# Menu
# ==============================
draw() {
    local cols lines visible scroll panel width mode_suffix="" artwork_suffix="" status_width name dir_name i idx
    cols=$(tput cols)
    lines=$(tput lines)
    enter_alternative_screen
    hide_cursor
    # Keep the list within the terminal height
    visible=$((lines - 1))
    (( visible < 1 )) && visible=1
    # Center the selection, clamped to the available entries
    scroll=$((CURSOR - visible / 2))
    (( scroll < 0 )) && scroll=0
    (( scroll > ${#ENTRIES[@]} - visible )) && scroll=$((${#ENTRIES[@]} - visible))
    (( scroll < 0 )) && scroll=0
    # Reserve the right half for track details
    panel=$((cols / 2 + 1))
    (( panel < 35 )) && panel=35
    width=$((panel - 2))
    # Show active playback and artwork settings
    case "$MODE" in
        chain)   mode_suffix=" [+chain]"   ;;
        shuffle) mode_suffix=" [+shuffle]" ;;
        repeat)  mode_suffix=" [+repeat]"  ;;
    esac
    (( ARTWORK_ENABLED )) || artwork_suffix=" [-artwork]"
    # Draw the current folder and track details
    dir_name="${CURRENT_DIR##*/}"
    printf "\e[H\e[J\e[1;1H\e[1;97m%s\e[0m" "${dir_name:-Root}"
    printf "\e[1;%dH\e[1;97mTrack Info\e[0m" "$panel"
    if [[ -n "$META_ARTIST" ]]; then
        printf "\e[2;%dH\e[37mArtist:\e[0m %-*s" "$panel" "$width" "$META_ARTIST"
        printf "\e[3;%dH\e[37mAlbum:\e[0m  %-*s" "$panel" "$width" "$META_ALBUM"
        printf "\e[4;%dH\e[37mYear:\e[0m   %-*s" "$panel" "$width" "$META_YEAR"
        printf "\e[5;%dH\e[37mTrack:\e[0m  %-*s" "$panel" "$width" "$META_TITLE"
        printf "\e[6;%dH\e[37mPos:\e[0m    %-*s" "$panel" "$width" "$META_TRACK"
    else
        printf "\e[2;%dH\e[2;37m(Directory)\e[0m" "$panel"
    fi
    # Place mode indicators at the bottom-right
    status_width=$((${#mode_suffix} + ${#artwork_suffix}))
    if (( status_width > 0 )); then
        printf "\e[%d;%dH\e[32m%s\e[31m%s\e[0m" "$lines" "$((cols - status_width + 1))" "$mode_suffix" "$artwork_suffix"
    fi
    # Render the visible portion of the directory list
    for ((i = 0; i < visible && i + scroll < ${#ENTRIES[@]}; i++)); do
        idx=$((i + scroll))
        name="${ENTRIES[idx]##*/}"
        (( idx      < DIR_COUNT )) && name="📁 $name/"
        (( ${#name} > width     )) && name="${name:0:$((width - 3))}..."
        printf "\e[%d;1H" "$((i + 2))"
        (( idx == CURSOR )) && printf "\e[7m"
        printf "%s\e[0m" "$name"
    done
}

# ==============================
# Navigation and controls
# ==============================
trap 'clean_artwork; show_cursor; exit_alternative_screen' EXIT
PATH_STACK=("$ROOT")
load_entries "$CURRENT_DIR"
update_metadata
while :; do
    draw
    key=$(read_key)
    case "$key" in
        up)    if (( CURSOR > 0                  )); then ((CURSOR--)); update_metadata; fi ;;
        down)  if (( CURSOR < ${#ENTRIES[@]} - 1 )); then ((CURSOR++)); update_metadata; fi ;;
        enter) if (( CURSOR < DIR_COUNT          )); then PATH_STACK+=("${ENTRIES[CURSOR]}"); CURRENT_DIR="${ENTRIES[CURSOR]}"; load_entries "$CURRENT_DIR"; CURSOR=0; update_metadata; elif (( CURSOR < ${#ENTRIES[@]} )); then clear; play_from "$CURSOR"; clear; fi ;;
        back)  if (( ${#PATH_STACK[@]} > 1       )); then unset "PATH_STACK[$(( ${#PATH_STACK[@]} - 1 ))]"; CURRENT_DIR="${PATH_STACK[$(( ${#PATH_STACK[@]} - 1 ))]}"; load_entries "$CURRENT_DIR"; CURSOR=0; update_metadata; fi ;;
        c|s|r|a)
            case "$key" in
                c) [[ $MODE == chain   ]] && MODE="" || MODE=chain   ;;
                s) [[ $MODE == shuffle ]] && MODE="" || MODE=shuffle ;;
                r) [[ $MODE == repeat  ]] && MODE="" || MODE=repeat  ;;
                a) (( ARTWORK_ENABLED = !ARTWORK_ENABLED ))          ;;
            esac ;;
        quit) exit 0 ;;
    esac
done
