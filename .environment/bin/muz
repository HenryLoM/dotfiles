#!/usr/bin/env bash

# ========== help ==========
case "$1" in
    -h|--help|help|h)
        echo "muz - lightweight local music library player (mpv-based)"
        echo
        echo "Usage: muz <music-directory>"
        echo
        echo "Controls:"
        echo "    ← / h               back"
        echo "    ↑ / j               move up"
        echo "    ↓ / k               move down"
        echo "    → / l / Enter       select"
        echo "    c                   toggle chain"
        echo "    q                   quit"
        echo
        echo "Dependencies: mpv (ffmpeg, icat - optional)"
        exit 0
        ;;
esac

# ========== path ==========
CACHE="$HOME/.cache/muz"
PATH_CACHE="$CACHE/path"
mkdir -p "$CACHE"

ROOT="${1:-$(cat "$PATH_CACHE" 2>/dev/null)}"

[[ -z "$ROOT" ]] && { echo "muz: usage: muz <music-directory>" >&2; exit 1; }
[[ ! -d "$ROOT" ]] && { echo "muz: directory not found: $ROOT" >&2; exit 1; }

echo "$ROOT" > "$PATH_CACHE"

# ========== state ==========
state="artists"
cursor=0
scroll=0
image_support=0
chain_enabled=0

artists=()
albums=()
tracks=()

current_artist=""
current_album=""

# ========== deps ==========
check_dependencies() {
    local missing=()
    for cmd; do command -v "$cmd" >/dev/null || missing+=("$cmd"); done
    ((${#missing[@]})) || return
    printf 'muz: missing: %s\n' "${missing[*]// /, }"
    exit 1
}

check_image_support() {
    [[ -n "$KITTY_WINDOW_ID" || "$TERM_PROGRAM" =~ ^(WezTerm|ghostty)$ ]] &&
    command -v ffmpeg >/dev/null &&
    { command -v kitten >/dev/null || command -v kitty >/dev/null; }
}

# ========== loaders ==========
load_list() {
    mapfile -t "$1" < <(
        find "$2" -mindepth 1 -maxdepth 1 \( -type d -o -type f \( \
        -iname '*.mp3' -o -iname '*.flac' \) \) \
        | LC_ALL=C.UTF-8 sort -"$3"
    )
}

load_artists() { load_list artists "$ROOT"           "f"; }
load_albums()  { load_list albums  "$current_artist" "r"; }
load_tracks()  { load_list tracks  "$current_album"     ; }

# ========== artwork ==========
add_artwork() {
    local f="$1"
    local tmp="$CACHE/cover.jpg"

    # Extract cover art; abort silently if ffmpeg fails or file has no cover
    ffmpeg -y -i "$f" -an -vcodec copy "$tmp" 2>/dev/null || return

    local w=$(tput cols)
    local h=$(tput lines)
    local c=$((h * 5 / 3))
    ((w < c)) && c=$w
    local x=$((w - c - 1))

    # Use 'kitty +kitten' or standalone 'kitten' depending on what is installed
    if command -v kitty >/dev/null 2>&1; then
        kitty +kitten icat --stdin no --place "${c}x${c}@${x}x1" "$tmp" 2>/dev/null
    else
        kitten icat --stdin no --place "${c}x${c}@${x}x1" "$tmp" 2>/dev/null
    fi

    rm -f "$tmp"
}

# ========== playback ==========
play_audio() {
    local file="${files[$cursor]}"

    ((image_support)) && add_artwork "$file"

    if ((chain_enabled)); then
        mpv --playlist-start="$cursor" \
            --config-dir="$HOME/.config/mpv/music-player" \
            --msg-level=ffmpeg=no,ao=no,vo=no,cplayer=no \
            --no-video \
            "${files[@]}"
    else
        mpv --config-dir="$HOME/.config/mpv/music-player" \
            --msg-level=ffmpeg=no,ao=no,vo=no,cplayer=no,osd/libass=no \
            --no-video \
            --term-status-msg=' ${time-pos:${=mm\\:ss}} | ${duration:${=mm\\:ss}}' \
            "${files[$cursor]}"
    fi
}

# ========== input ==========
read_key() {
    IFS= read -rsn1 k
    [[ $k == $'\x1b' ]] && read -rsn2 -t 0.01 r && k+=$r

    case "$k" in
        $'\x1b[A'|"k") echo up ;;
        $'\x1b[B'|"j") echo down ;;
        $'\x1b[C'|"l"|"") echo enter ;;
        $'\x1b[D'|"h"|$'\x1b') echo back ;;
        "c") echo toggle_chain ;;
        "q") echo quit ;;
    esac
}

# ========== ui ==========
draw() {
    # \e[H moves cursor to top-left, \e[J clears from cursor to end of screen.
    printf '\e[H\e[J'

    local list title suffix cols term_h visible max_scroll i item
    
    suffix=$(
        [[ $image_support -eq 0 ]] && echo -n " [-artworks]"
        [[ $chain_enabled -eq 1 ]] && echo -n " [+chain]"
        )

    case "$state" in
        artists) list=("${artists[@]}"); title="Artists" ;;
        albums)  list=("${albums[@]}");  title="Albums: ${current_artist##*/}" ;;
        tracks)  list=("${tracks[@]}");  title="Tracks: ${current_album##*/}"  ;;
    esac

    cols=$(tput cols)
    term_h=$(tput lines)
    visible=$((term_h - 3))

    # scrolling logic
    if (( cursor < scroll )); then
        scroll=$cursor
    elif (( cursor >= scroll + visible )); then
        scroll=$(( cursor - visible + 1 ))
    fi
    
    max_scroll=$(( ${#list[@]} - visible ))
    (( max_scroll < 0 )) && max_scroll=0
    (( scroll > max_scroll )) && scroll=$max_scroll
    (( scroll < 0 )) && scroll=0

    # print header
    local pad=$(( cols - ${#title} ))
    (( pad < 0 )) && pad=0
    printf "%s%*s\n\n" "$title" "$pad" "$suffix"

    # print list
    for ((i=scroll; i<scroll+visible && i<${#list[@]}; i++)); do
        item="${list[$i]##*/}"
        if (( i == cursor )); then
            printf ">%s\n" "$item"
        else
            printf " %s\n" "$item"
        fi
    done
}

# ========== init ==========
check_dependencies mpv
check_image_support && image_support=1
load_artists

# ========== loop ==========
while true; do
    draw
    key=$(read_key)

    case "$key" in
        up) ((cursor--)); ((cursor<0)) && cursor=0 ;;
        down)
            ((cursor++))
            case "$state" in
                artists) max=$((${#artists[@]}-1)) ;;
                albums)  max=$((${#albums[@]}-1))  ;;
                tracks)  max=$((${#tracks[@]}-1))  ;;
            esac
            ((cursor>max)) && cursor=$max
            ;;
        enter)
            case "$state" in
                artists)
                    current_artist="${artists[$cursor]}"
                    cursor=0; scroll=0
                    load_albums
                    state="albums"
                    ;;
                albums)
                    current_album="${albums[$cursor]}"
                    cursor=0; scroll=0
                    load_tracks
                    state="tracks"
                    ;;
                tracks)
                    files=("${tracks[@]}")
                    clear
                    play_audio
                    clear
                    ;;
            esac
            ;;
        back)
            case "$state" in
                albums) state="artists" ;;
                tracks) state="albums" ;;
                *) clear; exit ;;
            esac
            cursor=0; scroll=0
            ;;
        toggle_chain) ((chain_enabled=!chain_enabled)) ;;
        quit) clear; exit 0 ;;
    esac
done
