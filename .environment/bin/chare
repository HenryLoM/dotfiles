#!/usr/bin/env bash

# ==============================
# Help
# ==============================
case "${1:-}" in --help|-help|help|--h|-h|h)
        echo "chare (v1.4) - minimal local file sharing"
        echo
        echo "Usage: chare [file|dir] [-r|--receive]"
        echo
        echo "Dependencies: python3 qrencode?"
        exit 0
        ;;
esac

# ==============================
# Dependencies
# ==============================
for cmd in python3; do
    command -v "$cmd" >/dev/null 2>&1 || { echo "chare: missing dependency: $cmd" >&2; missing=1; }
done
(( !${missing:-0} )) || exit 1

# ==============================
# Setup
# ==============================
MODE=share
TARGET=.
for arg in "$@"; do
    case "$arg" in
        -r|--receive) MODE=receive ;;
        *) TARGET=$arg ;;
    esac
done

if [[ "$MODE" == receive && -f "$TARGET" ]]; then
    TARGET=$(dirname "$TARGET")
fi

[[ -e "$TARGET" || "$MODE" == receive ]] || { echo "chare: not found: $TARGET" >&2; exit 1; }
[[ "$MODE" != receive ]] || mkdir -p "$TARGET" || exit 1
TARGET=$(cd "$TARGET" 2>/dev/null && pwd -P) || exit 1
[[ "$MODE" == receive || -f "$TARGET" || -d "$TARGET" ]] || { echo "chare: not found" >&2; exit 1; }

PORT=${PORT:-8000}
TOKEN=$(python3 -c 'import secrets; print(secrets.token_hex(3))') || exit 1
URL="http://$(hostname -s).local:$PORT/$TOKEN"

printf 'chare\n\n%s: %s\nLink: %s\n' "$([[ $MODE == receive ]] && echo Receiving at || echo Sharing)" "${TARGET##*/}" "$URL"
command -v qrencode >/dev/null 2>&1 && qrencode -t UTF8 -m 2 "$URL" 2>/dev/null
printf '\nCTRL+C to exit\n\n'

# ==============================
# Server
# ==============================
exec python3 - "$MODE" "$TARGET" "$TOKEN" "$PORT" <<'PY'
import os, sys
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
from urllib.parse import quote, urlsplit
from email.parser import BytesParser
from email.policy import default

mode, target, token, port = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
root = f"/{token}"
is_file = os.path.isfile(target)

class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=os.path.dirname(target) if is_file else target, **kw)

    def log_message(self, *a): pass

    def do_GET(self):
        path = urlsplit(self.path).path
        if path == root and mode == "receive":
            page = f'<meta name="viewport" content="width=device-width"><h3>chare</h3><form method="post" enctype="multipart/form-data"><input type="file" name="file" required><button>Upload</button></form>'
            self.send_response(200); self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers(); self.wfile.write(page.encode())
        elif path == root and is_file:
            self.send_response(200)
            self.send_header("Content-Disposition", "attachment; filename*=UTF-8''" + quote(os.path.basename(target)))
            self.send_header("Content-Length", str(os.path.getsize(target)))
            self.end_headers()
            try:
                with open(target, "rb") as f:
                    while data := f.read(65536): self.wfile.write(data)
            except (BrokenPipeError, ConnectionResetError): pass
        elif path == root and not is_file:
            self.send_response(302); self.send_header("Location", root + "/"); self.end_headers()
        elif path.startswith(root + "/") and mode == "share" and not is_file:
            self.path = path[len(token) + 1:]; super().do_GET()
        else: self.send_error(404)

    def do_POST(self):
        if mode != "receive" or urlsplit(self.path).path != root: return self.send_error(404)
        data = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        msg = BytesParser(policy=default).parsebytes(
            b"Content-Type: " + self.headers["Content-Type"].encode() + b"\r\nMIME-Version: 1.0\r\n\r\n" + data)
        part = next((p for p in msg.iter_parts() if p.get_param("name", header="content-disposition") == "file"), None)
        if not part or not part.get_filename(): return self.send_error(400)
        name = os.path.basename(part.get_filename())
        try:
            with open(os.path.join(target, name), "xb") as f: f.write(part.get_payload(decode=True))
        except FileExistsError:
            return self.send_error(409, "File already exists")
        self.send_response(303); self.send_header("Location", root); self.end_headers()

try:
    ThreadingHTTPServer(("0.0.0.0", port), Handler).serve_forever()
except KeyboardInterrupt:
    pass
PY
