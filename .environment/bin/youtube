#!/usr/bin/env bash

# ==============================
# Help
# ==============================
case "${1:-}" in --help|-help|help|--h|-h|h)
        echo "youtube (v1.2) - terminal YouTube client"
        echo
        echo "Usage: youtube"
        echo
        echo "Controls:"
        echo "    ↑                   move up"
        echo "    ↓                   move down"
        echo "    Enter               select / play"
        echo "    Esc                 go back"
        echo
        echo "Dependencies: yt-dlp mpv fzf"
        echo "Cache: ~/.cache/youtube/"
        exit 0
        ;;
esac

# ==============================
# Dependencies
# ==============================
dependencies=(yt-dlp mpv fzf)
for cmd in "${dependencies[@]}"; do
    command -v "$cmd" >/dev/null 2>&1 || { printf 'youtube: missing dependency: %s\n' "$cmd" >&2; missing=1; }
done
(( !${missing:-0} )) || exit 1

# ==============================
# Cache
# ==============================
CACHE_DIR="$HOME/.cache/youtube"
CACHED_BOOKMARKS="$CACHE_DIR/bookmarks.tsv"
CACHED_HISTORY="$CACHE_DIR/history.tsv"
mkdir -p "$CACHE_DIR"
touch "$CACHED_BOOKMARKS" "$CACHED_HISTORY"

TMP=$(mktemp) || exit 1
trap 'rm -f "$TMP"' EXIT

# ==============================
# Helpers
# ==============================
play() {
    mpv "https://www.youtube.com/watch?v=$ID"
    grep -Fq "$(printf '\t%s' "$ID")" "$CACHED_HISTORY" ||
        printf '%s\t%s\n' "$TITLE" "$ID" >> "$CACHED_HISTORY"
}

browse() {
    local file="$1" label="$2" selected action

    while selected=$(fzf --delimiter=$'\t' --with-nth=1 \
        --prompt="$label > " --height=100% --reverse --border < "$file"); do
        TITLE="${selected%	*}"
        ID="${selected##*	}"
        [[ "$label" != Search ]] || printf '%s\t%s\n' "$TITLE" "$ID" >> "$TMP"

        while action=$(printf '%s\n' '▶ Play' '▣ Bookmark / remove' '↩ Back' |
            fzf --prompt='Video > ' --reverse --border); do
            case "$action" in
                '▶ Play') play ;;
                '▣ Bookmark / remove')
                    if grep -Fq "$(printf '\t%s' "$ID")" "$CACHED_BOOKMARKS"; then
                        grep -Fv "$(printf '\t%s' "$ID")" "$CACHED_BOOKMARKS" > "$TMP"
                        cp "$TMP" "$CACHED_BOOKMARKS"
                    else
                        printf '%s\t%s\n' "$TITLE" "$ID" >> "$CACHED_BOOKMARKS"
                    fi
                    ;;
                *) break ;;
            esac
        done
    done
}

search_videos() {
    read -r -p 'Search YouTube: ' query
    [[ -n "$query" ]] || continue
    yt-dlp --flat-playlist --no-warnings \
        --playlist-end 20 \
        --print "%(title)s"$'\t'"%(id)s" \
        "ytsearch20:$query" 2>/dev/null > "$TMP"
    browse "$TMP" Search
}

# ==============================
# Entry Point
# ==============================
trap 'clear' EXIT
while choice=$(printf '%s\n' '⌕ Search' '▣ Bookmarks' '◷ History' '× Quit' |
    fzf --prompt='youtube > ' --height=100% --reverse --border); do
    case "$choice" in
        '⌕ Search')    clear; search_videos                 ;;
        '▣ Bookmarks') browse "$CACHED_BOOKMARKS" Bookmarks ;;
        '◷ History')   browse "$CACHED_HISTORY"   History   ;;
        '× Quit')      break                                ;;
    esac; clear
done
